{
  "name": "rammah-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "assets:seo": "node scripts/generate-seo-assets.mjs",
    "lint": "eslint",
    "test:unit": "vitest run lib",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:regression:booking": "vitest run --config vitest.regression.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"for (const path of ['.next', 'coverage', 'dist', 'out', 'output', '.playwright-cli']) require('node:fs').rmSync(path, { recursive: true, force: true })\""
  },
  "engines": {
    "node": "24.14.0",
    "npm": "11.9.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dancing-script": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "cobe": "0.6.5",
    "gsap": "^3.14.2",
    "motion": "^12.40.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^27.4.0",
    "sharp": "0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
