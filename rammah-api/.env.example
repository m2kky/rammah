NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001

DATABASE_URL=postgres://postgres:postgres@localhost:55432/rammah

ADMIN_SESSION_SECRET=development-secret-change-me
ADMIN_SEED_EMAIL=admin@rammah.local
ADMIN_SEED_PASSWORD=ChangeMe123!
ADMIN_SEED_NAME=Ahmed Ramah Admin
REQUEST_LOG_LEVEL=info

# Payments
# Local/test values only. Keep live secrets out of source control.
PAYMENT_PROVIDER=kashier
PAYMENT_MODE=test
PAYMENT_HOLD_MINUTES=15
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_SECRET=
KASHIER_ALLOWED_METHODS=card
KASHIER_CALLBACK_URL=http://localhost:4000/api/v1/webhooks/payments/kashier
KASHIER_RETURN_URL=http://localhost:3000/booking/payment/return

# Google Calendar / Meet
# Create an OAuth client in Google Cloud and add this exact redirect URI.
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are accepted as aliases.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/api/v1/admin/integrations/google-calendar/callback
GOOGLE_CALENDAR_DEFAULT_CALENDAR_ID=primary
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# Email notifications
# Use mock locally; switch to resend in production after domain verification.
EMAIL_PROVIDER=mock
EMAIL_FROM=Rammah <no-reply@rammah.local>
EMAIL_ADMIN_RECIPIENTS=admin@rammah.local
RESEND_API_KEY=

# CMS media uploads (Cloudflare R2)
# Keep disabled until all required R2 values are configured.
R2_UPLOADS_ENABLED=false
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=rammah-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://pub-REPLACE.r2.dev
R2_PRESIGN_EXPIRES_SECONDS=300
R2_MAX_IMAGE_BYTES=15728640
R2_MAX_VIDEO_BYTES=524288000
R2_MAX_ANIMATION_ZIP_BYTES=524288000
R2_MAX_ANIMATION_EXPANDED_BYTES=2147483648
R2_MAX_ANIMATION_FRAMES=2000
R2_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/avif
R2_ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/webm,video/quicktime
R2_TEMP_PREFIX=tmp
R2_MEDIA_PREFIX=media
R2_TEMP_RETENTION_DAYS=1

# Durable background worker
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_CONCURRENCY=4
JOB_LEASE_SECONDS=120
JOB_TIMEOUT_SECONDS=90
JOB_MAX_ATTEMPTS=8
JOB_BACKOFF_BASE_MS=1000
JOB_BACKOFF_MAX_MS=300000
WORKER_DRAIN_TIMEOUT_MS=30000
