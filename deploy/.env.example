NODE_ENV=production
PORT=4000
API_BASE_PATH=/api/v1
FRONTEND_ORIGIN=https://www.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/rammah
ADMIN_SESSION_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_SEED_NAME=Rammah Admin
REQUEST_LOG_LEVEL=info
COUNTRY_HEADER_PROVIDER=none
TRUSTED_PROXY_CIDRS=

PAYMENT_PROVIDER=kashier
PAYMENT_MODE=live
PAYMENT_HOLD_MINUTES=15
PAYMENT_SUPPORTED_CURRENCIES=EGP
ADMIN_PRICE_WRITES_ENABLED=true
BOOKING_CHANGE_MINIMUM_NOTICE_MINUTES=1440
BOOKING_DAILY_LIMIT=8
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_SECRET=
KASHIER_ALLOWED_METHODS=card
KASHIER_CALLBACK_URL=https://api.example.com/api/v1/webhooks/payments/kashier
KASHIER_RETURN_URL=https://www.example.com/booking/payment/return

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://api.example.com/api/v1/admin/integrations/google-calendar/callback
GOOGLE_CALENDAR_DEFAULT_CALENDAR_ID=primary
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

EMAIL_PROVIDER=resend
EMAIL_FROM=Rammah <bookings@example.com>
EMAIL_ADMIN_RECIPIENTS=admin@example.com
RESEND_API_KEY=

# CMS media uploads (Cloudflare R2)
# Set R2_UPLOADS_ENABLED=true only after replacing every required value.
R2_UPLOADS_ENABLED=false
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=rammah-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://pub-REPLACE.r2.dev
R2_PRESIGN_EXPIRES_SECONDS=300
R2_MAX_IMAGE_BYTES=15728640
R2_MAX_VIDEO_BYTES=524288000
R2_MAX_ANIMATION_ZIP_BYTES=524288000
R2_MAX_ANIMATION_EXPANDED_BYTES=2147483648
R2_MAX_ANIMATION_FRAMES=2000
R2_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/avif
R2_ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/webm,video/quicktime
R2_TEMP_PREFIX=tmp
R2_MEDIA_PREFIX=media
R2_TEMP_RETENTION_DAYS=1
CMS_PREVIEW_SECRET=replace-with-a-separate-random-secret-at-least-32-bytes
CMS_PREVIEW_MAX_AGE_SECONDS=300

WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_CONCURRENCY=4
JOB_LEASE_SECONDS=120
JOB_TIMEOUT_SECONDS=90
JOB_MAX_ATTEMPTS=8
JOB_BACKOFF_BASE_MS=1000
JOB_BACKOFF_MAX_MS=300000
WORKER_DRAIN_TIMEOUT_MS=30000
